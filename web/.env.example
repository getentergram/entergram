# Stripe Payment Link for the $500 install (create at dashboard.stripe.com → Payment Links)
NEXT_PUBLIC_STRIPE_LINK=https://buy.stripe.com/xxxxxxxx

# Optional: UPI payment link for the $500 install, shown as a secondary CTA (e.g. a Razorpay
# Payment Link with UPI enabled — dashboard.razorpay.com → Payment Links). Leave unset to hide it.
NEXT_PUBLIC_UPI_LINK=

# Optional: Stripe subscription Payment Links for the monthly tiers. When set, that tier's
# button becomes "Subscribe" → the link; when unset it falls back to the waitlist.
NEXT_PUBLIC_STRIPE_STARTER=
NEXT_PUBLIC_STRIPE_PRO=
NEXT_PUBLIC_STRIPE_TEAMS=

# Public GitHub repo URL (shown on Star / GitHub links)
NEXT_PUBLIC_GITHUB_LINK=https://github.com/chandrasaripaka/engram

# Optional: forward waitlist signups to a webhook (Formspree / Buttondown / Zapier / Apps Script).
# If unset, signups are accepted and logged to the server console.
WAITLIST_WEBHOOK=
